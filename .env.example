# Mau cau hinh chung. Sao chep file nay thanh .env de chay ung dung.
# Chi dien mat khau that trong .env. Khong commit .env len Git.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=webst9;encrypt=false;trustServerCertificate=true;sslProtocol=TLSv1.2;characterEncoding=UTF-8
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME
SERVER_PORT=8081
DDL_AUTO=update
SHOW_SQL=false

# SMTP Gmail. Dung App Password, khong dung mat khau Gmail thong thuong.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=CHANGE_ME

# Cloudinary dung cho anh san pham.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Tai khoan admin chi duoc tao khi APP_ADMIN_PASSWORD khac rong va khac CHANGE_ME.
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=CHANGE_ME
